# 复制为 .env 并填入真实值（.env 不会提交/打包）
# 飞书开放平台 → 你的应用 → 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 可选：固定 Flask session 密钥（不设置则每次启动随机生成，重启后 session 失效）
# FLASK_SECRET_KEY=

# 可选：Token 落盘加密密钥（Fernet；不设置则明文存储）
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOKEN_ENCRYPTION_KEY=

# 预留：LLM 增强抽取（默认走本地 Ollama，未启动时自动降级为纯规则抽取）
LLM_API_URL=http://localhost:11434/v1
# LLM_API_KEY=
LLM_MODEL=qwen2.5:7b
